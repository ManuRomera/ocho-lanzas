<article class="ol-purify-card">
  <header class="ol-roll-header-banner">
    <h4>{{localize "OCHO.Chat.PurifyTitle"}}</h4>
  </header>
  <div class="ol-purify-compact">
    <span class="ol-purify-mark" aria-hidden="true"></span>
    <strong>{{before}} → {{after}}</strong>
    <span>{{localize "OCHO.Sections.Curse"}}</span>
  </div>
  <div class="ol-purify-consequence-box">
    <strong>{{localize "OCHO.Chat.PurifyConsequence"}}</strong>
    <span>{{consequence}}</span>
  </div>
</article>