<article class="ol-curse-card">
  <header class="ol-roll-header-banner">
    <h4>{{title}}</h4>
    {{#if subtitle}}<span class="ol-roll-subtitle">{{subtitle}}</span>{{/if}}
  </header>
  <div class="ol-curse-chat-line">
    <span class="ol-curse-chat-die">{{die}}</span>
    <strong>{{before}} → {{after}}</strong>
    <span>{{#if increased}}{{localize "OCHO.Chat.CurseIncreases"}}{{else}}{{localize "OCHO.Chat.CurseNoIncrease"}}{{/if}}</span>
  </div>
  {{#if bakemono}}<div class="ol-bakemono-warning">{{localize "OCHO.Chat.Bakemono"}}</div>{{/if}}
</article>