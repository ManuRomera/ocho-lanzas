<section class="ol-yomi-shell-inner">
  <header class="ol-yomi-toolbar">
    <div class="ol-yomi-titleblock">
      <span class="ol-yomi-badge">{{localize "OCHO.Yomi.AdventureLabel"}}</span>
      <h2>{{title}}</h2>
      <p>{{localize "OCHO.Yomi.DirectorPanelHint"}}</p>
    </div>
    <div class="ol-yomi-actions">
      {{#if isGM}}<button type="button" data-action="seedWorld"><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "OCHO.Yomi.Install"}}</button>{{/if}}
      <button type="button" data-action="reload"><i class="fa-solid fa-rotate-right"></i> {{localize "OCHO.Yomi.Reload"}}</button>
    </div>
  </header>
  <div class="ol-yomi-frame-wrap"><iframe class="ol-yomi-frame" src="{{htmlPath}}" title="{{title}}"></iframe></div>
</section>