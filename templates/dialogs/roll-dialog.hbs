<form class="ocho-lanzas ol-roll-dialog-v5" autocomplete="off">
  <header class="ol-dialog-header">
    <div><span class="ol-kicker">{{actorName}}</span><h2>{{localize "OCHO.Roll.IntentQuestion"}}</h2></div>
    <div class="ol-dialog-mode" role="radiogroup" aria-label="{{localize 'OCHO.Roll.TypeLabel'}}">
      <label><input type="radio" name="rollType" value="risk" {{#if (eq rollType "risk")}}checked{{/if}} /><span>{{localize "OCHO.Roll.Type.Risk"}}</span></label>
      <label><input type="radio" name="rollType" value="curse" {{#if (eq rollType "curse")}}checked{{/if}} /><span>{{localize "OCHO.Roll.Type.Curse"}}</span></label>
    </div>
  </header>

  <label class="ol-dialog-intent">
    <span>{{localize "OCHO.Roll.IntentLabel"}}</span>
    <input type="text" name="flavor" value="{{flavor}}" placeholder="{{localize 'OCHO.Roll.IntentPlaceholder'}}" />
  </label>

  <section class="ol-risk-mode">
    <div class="ol-roll-source-grid">
      <fieldset class="ol-source-group">
        <legend>{{localize "OCHO.Roll.WhatHelps"}}</legend>
        <p>{{localize "OCHO.Roll.WhiteSourcesHintSingle"}}</p>
        <label class="ol-source-option is-none"><input type="radio" name="bonusSource" value="" checked /><span>{{localize "OCHO.Roll.NoExtraSource"}}</span></label>
        {{#each bonusSources as |source|}}
        <label class="ol-source-option">
          <input type="radio" name="bonusSource" value="{{source.label}}" />
          <span><small>{{source.badge}}</small><strong>{{source.label}}</strong></span>
        </label>
        {{/each}}
      </fieldset>

      <fieldset class="ol-source-group is-cursed">
        <legend>{{localize "OCHO.Roll.CurseExposureQuestion"}}</legend>
        <p>{{localize "OCHO.Roll.CursedSourcesHintSingle"}}</p>
        <label class="ol-source-option is-none"><input type="radio" name="cursedSource" value="" checked /><span>{{localize "OCHO.Roll.NoCursedSource"}}</span></label>
        {{#each cursedSources as |source|}}
        <label class="ol-source-option">
          <input type="radio" name="cursedSource" value="{{source.label}}" />
          <span><small>{{source.badge}}</small><strong>{{source.label}}</strong></span>
        </label>
        {{/each}}
      </fieldset>
    </div>

    <section class="ol-roll-preview" aria-live="polite">
      <span class="ol-kicker">{{localize "OCHO.Roll.YouWillRoll"}}</span>
      <strong data-preview-white>{{localize "OCHO.Roll.PreviewOneWhite"}}</strong>
      <strong class="is-cursed" data-preview-cursed hidden>{{localize "OCHO.Roll.PreviewOneCursed"}}</strong>
      <div data-preview-sources></div>
    </section>
  </section>

  <section class="ol-curse-mode">
    <span class="ol-kicker">{{localize "OCHO.Roll.CurseRollTitle"}}</span>
    <div class="ol-curse-mode-value"><span>{{localize "OCHO.Roll.CurrentCurse"}}</span><strong>{{curseCount}}</strong></div>
    <p>{{localize "OCHO.Roll.CurseModeRule"}}</p>
    <div class="ol-roll-preview"><strong class="is-cursed">{{localize "OCHO.Roll.PreviewOneCursed"}}</strong></div>
  </section>
</form>