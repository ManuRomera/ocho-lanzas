<form class="ocho-lanzas ol-purify-dialog-v5" autocomplete="off">
  <header class="ol-dialog-header ol-purify-header">
    <div><span class="ol-kicker">{{localize "OCHO.Sections.Curse"}}</span><h2>{{localize "OCHO.Purify.Title"}}</h2></div>
    <div class="ol-purify-change"><strong>{{before}}</strong><span>→</span><strong>{{after}}</strong></div>
  </header>
  <p class="ol-dialog-lead">{{localize "OCHO.Purify.Text"}}</p>
  <label class="ol-purify-consequence">
    <span>{{localize "OCHO.Purify.PriceQuestion"}}</span>
    <textarea name="consequence" placeholder="{{localize 'OCHO.Purify.ConsequencePlaceholder'}}" autofocus></textarea>
  </label>
</form>