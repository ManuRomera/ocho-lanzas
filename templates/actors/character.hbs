<form class="{{cssClass}} ocho-lanzas ol-root ol-character-sheet" autocomplete="off">
  <section class="ol-sheet ol-sheet-v5">
    <header class="ol-header ol-header-v5">
      <div class="ol-left">
        <div class="ol-brush ol-name">
          <div class="ol-brush-label">{{localize "OCHO.Fields.Name"}}</div>
          <input type="text" name="name" value="{{document.name}}" />
        </div>
        <button type="button" class="ol-rollbtn" data-action="rollAction" title="{{localize 'OCHO.Actions.RollAction'}}">
          <i class="fas fa-dice"></i><span>{{localize "OCHO.Actions.RollAction"}}</span>
        </button>
      </div>

      <div class="ol-portrait">
        <img class="profile-img" src="{{document.img}}" alt="{{document.name}}" data-edit="img" />
      </div>

      <div class="ol-topright">
        <div class="ol-brush ol-idea">
          <div class="ol-brush-label">{{localize "OCHO.Fields.Concept"}}</div>
          <input type="text" name="system.concept" value="{{system.concept}}" />
        </div>
        <div class="ol-field ol-occupation">
          <div class="ol-smalllabel">{{localize "OCHO.Fields.Occupation"}}</div>
          <input type="text" name="system.occupation" value="{{system.occupation}}" />
        </div>
      </div>
    </header>

    <section class="ol-character-main-grid">
      <div class="ol-character-leftcol">
        <section class="ol-box ol-traits-summary">
          <div class="ol-box-head">
            <h3>{{localize "OCHO.Sections.Traits"}}</h3>
            {{#if canEditDocument}}
            <button type="button" class="ol-text-action" data-action="toggleTraits">
              {{#if editingTraits}}{{localize "OCHO.Actions.FinishEditing"}}{{else}}{{localize "OCHO.Actions.EditTraits"}}{{/if}}
            </button>
            {{/if}}
          </div>

          {{#if editingTraits}}
          <div class="ol-trait-edit-grid">
            <div>
              <h4>{{localize "OCHO.Sections.Background"}}</h4>
              {{#each backgroundOptions as |opt|}}
              <label class="ol-trait-choice ol-info-target" tabindex="0"
                data-ol-info-title="{{opt.label}}" data-ol-info-category="{{localize 'OCHO.Sections.Background'}}" data-ol-info-body="{{opt.description}}">
                <input type="checkbox" name="system.backgrounds" value="{{opt.value}}" {{olChecked ../system.backgrounds opt.value}} />
                <span>{{opt.label}}</span>
              </label>
              {{/each}}
            </div>
            <div>
              <h4>{{localize "OCHO.Sections.Pride"}}</h4>
              {{#each prideOptions as |opt|}}
              <label class="ol-trait-choice ol-info-target" tabindex="0"
                data-ol-info-title="{{opt.label}}" data-ol-info-category="{{localize 'OCHO.Sections.Pride'}}" data-ol-info-body="{{opt.description}}">
                <input type="checkbox" name="system.prides" value="{{opt.value}}" {{olChecked ../system.prides opt.value}} />
                <span>{{opt.label}}</span>
              </label>
              {{/each}}
            </div>
            <div>
              <h4>{{localize "OCHO.Sections.Onmyoujis"}}</h4>
              <p class="ol-trait-warning">{{localize "OCHO.Traits.OnmyoujiCurseHint"}}</p>
              {{#each onmyoujiOptions as |opt|}}
              <label class="ol-trait-choice ol-info-target" tabindex="0"
                data-ol-info-title="{{opt.label}}" data-ol-info-category="{{localize 'OCHO.Sections.Onmyoujis'}}" data-ol-info-body="{{opt.description}}">
                <input type="checkbox" name="system.onmyoujis" value="{{opt.value}}" {{olChecked ../system.onmyoujis opt.value}} />
                <span>{{opt.label}}</span>
              </label>
              {{/each}}
            </div>
          </div>
          {{else}}
          <div class="ol-trait-summary-grid">
            <div>
              <h4>{{localize "OCHO.Sections.Background"}}</h4>
              <div class="ol-chip-list">
                {{#each selectedBackgrounds as |opt|}}
                <button type="button" class="ol-trait-chip ol-info-target" data-ol-info-title="{{opt.label}}"
                  data-ol-info-category="{{localize 'OCHO.Sections.Background'}}" data-ol-info-body="{{opt.description}}">{{opt.label}}</button>
                {{/each}}
              </div>
            </div>
            <div>
              <h4>{{localize "OCHO.Sections.Pride"}}</h4>
              <div class="ol-chip-list">
                {{#each selectedPrides as |opt|}}
                <button type="button" class="ol-trait-chip ol-info-target" data-ol-info-title="{{opt.label}}"
                  data-ol-info-category="{{localize 'OCHO.Sections.Pride'}}" data-ol-info-body="{{opt.description}}">{{opt.label}}</button>
                {{/each}}
              </div>
            </div>
            <div>
              <h4>{{localize "OCHO.Sections.Onmyoujis"}}</h4>
              <div class="ol-chip-list">
                {{#each selectedOnmyoujis as |opt|}}
                <button type="button" class="ol-trait-chip ol-info-target is-cursed" data-ol-info-title="{{opt.label}}"
                  data-ol-info-category="{{localize 'OCHO.Sections.Onmyoujis'}}" data-ol-info-body="{{opt.description}}">{{opt.label}}</button>
                {{/each}}
              </div>
            </div>
          </div>
          {{/if}}
        </section>

        <section class="ol-box ol-equipment-v5">
          <div class="ol-box-head">
            <h3>{{localize "OCHO.Sections.Equipment"}}</h3>
            {{#if canEditDocument}}
            <button type="button" class="ol-icon-action" data-action="itemAdd" title="{{localize 'OCHO.Items.Add'}}"><i class="fa-solid fa-plus"></i></button>
            {{/if}}
          </div>
          {{#if hasEquipmentItems}}
          <div class="ol-item-list">
            {{#each equipmentItems as |item|}}
            <article class="ol-item-row ol-info-target" data-item-id="{{item.id}}" draggable="true" tabindex="0"
              data-ol-info-title="{{item.name}}" data-ol-info-category="{{item.typeLabel}}" data-ol-info-body="{{item.descriptionText}}">
              <img src="{{item.img}}" alt="" />
              <div class="ol-item-main" data-action="itemOpen">
                <strong>{{item.name}}</strong>
                <span>{{item.typeLabel}}{{#if item.tagsText}} · {{item.tagsText}}{{/if}}</span>
              </div>
              {{#if item.quantity}}<span class="ol-item-qty">×{{item.quantity}}</span>{{/if}}
              {{#if ../canEditDocument}}
              <div class="ol-item-actions">
                <button type="button" data-action="itemEdit" title="{{localize 'OCHO.Items.Edit'}}"><i class="fa-solid fa-pen"></i></button>
                <button type="button" data-action="itemDelete" title="{{localize 'OCHO.Items.Delete'}}"><i class="fa-solid fa-trash"></i></button>
              </div>
              {{/if}}
            </article>
            {{/each}}
          </div>
          {{else}}
          <p class="ol-empty-state">{{localize "OCHO.Items.Empty"}}</p>
          {{/if}}
          {{#if hasLegacyEquipment}}
          <details class="ol-legacy-equipment">
            <summary>{{localize "OCHO.Items.LegacyEquipment"}}</summary>
            <textarea name="system.equipmentText" class="ol-freetext">{{system.equipmentText}}</textarea>
          </details>
          {{/if}}
        </section>

        <div class="ol-story-grid">
          <section class="ol-box"><h3>{{localize "OCHO.Sections.Bonds"}}</h3><textarea name="system.bondsText" class="ol-freetext">{{system.bondsText}}</textarea></section>
          <section class="ol-box"><h3>{{localize "OCHO.Sections.Events"}}</h3><textarea name="system.eventsText" class="ol-freetext">{{system.eventsText}}</textarea></section>
          <section class="ol-box ol-story-wide"><h3>{{localize "OCHO.Sections.Haika"}}</h3><textarea name="system.haikaText" class="ol-freetext">{{system.haikaText}}</textarea></section>
        </div>
      </div>

      <aside class="ol-character-rightcol">
        <section class="ol-curse ol-curse-v5" aria-label="{{localize 'OCHO.Sections.Curse'}}">
          <div class="ol-curse-head">
            <h3>{{localize "OCHO.Sections.Curse"}}</h3>
            <span class="ol-curse-min">{{localize "OCHO.Fields.CurseMin"}}: {{curseMin}}</span>
          </div>
          <div class="ol-curse-ring {{#unless isGM}}is-readonly{{/unless}}">
            {{#each cursePips as |p|}}
            <button type="button" class="ol-pip {{p.cls}}" data-pip="{{p.n}}" aria-label="{{p.n}}" {{#unless ../isGM}}disabled{{/unless}}></button>
            {{/each}}
            <div class="ol-curse-value">{{curseCount}}</div>
          </div>
          {{#if isGM}}
          <div class="ol-curse-controls">
            <button type="button" class="ol-mini" data-action="curseDec" title="-1">−</button>
            <button type="button" class="ol-mini" data-action="curseInc" title="+1">+</button>
            <button type="button" class="ol-mini" data-action="curseReset" title="{{localize 'OCHO.Actions.CurseReset'}}">↺</button>
          </div>
          {{/if}}
          <button type="button" class="ol-purify-button" data-action="purify" {{#unless canPurify}}disabled{{/unless}}>{{localize "OCHO.Actions.Purify"}}</button>
          <textarea class="ol-curse-notes" name="system.curse" placeholder="{{localize 'OCHO.Placeholder.CurseNotes'}}">{{system.curse}}</textarea>
        </section>

        <section class="ol-box ol-notes ol-notes-v5">
          <h3>{{localize "OCHO.Sections.Notes"}}</h3>
          <textarea name="system.notes" placeholder="{{localize 'OCHO.Sections.Notes'}}">{{system.notes}}</textarea>
        </section>
      </aside>
    </section>
  </section>
</form>